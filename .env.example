# APPLICATION
APP_NAME=GST Practice Copilot
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
STREAMLIT_PORT=8501

# LOCAL LLM CONFIGURATION (OpenAI-compatible: vLLM, Ollama /v1, llama.cpp, DeepInfra, etc.)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://retread-froth-stunning.ngrok-free.dev
LLM_API_KEY=
LLM_MODEL=gpt-oss-extended
LLM_TEMPERATURE=0
LLM_TIMEOUT=180
LLM_MAX_RETRIES=2

# OPTIONAL: HTTP Basic Authentication (e.g. for ngrok tunnels with basic-auth enabled)
LLM_BASIC_AUTH_USERNAME=colab
LLM_BASIC_AUTH_PASSWORD=yashsheth1234

# OPTIONAL: Separate LLM for Query Understanding (falls back to LLM_* if unset)
# RESEARCH_LLM_BASE_URL=
# RESEARCH_LLM_API_KEY=
# RESEARCH_LLM_MODEL=
# RESEARCH_LLM_TEMPERATURE=0
# RESEARCH_LLM_TIMEOUT=180
# RESEARCH_LLM_MAX_RETRIES=2
# RESEARCH_LLM_BASIC_AUTH_USERNAME=
# RESEARCH_LLM_BASIC_AUTH_PASSWORD=

# WEB SEARCH
SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8080
SEARXNG_TIMEOUT=30
SEARXNG_ENGINES=bing,yahoo
SEARXNG_USE_SITE_OPERATORS=false
MAX_SEARCH_RESULTS=20
MAX_FETCH_SOURCES=8
MAX_RESEARCH_RETRIES=2
MIN_OFFICIAL_SOURCES_SUFFICIENT=2
MAX_EVIDENCE_SOURCES_FOR_LLM=5

# SOURCE VALIDATION
ENFORCE_OFFICIAL_DOMAINS=true
ALLOW_UNVERIFIED_FALLBACK=false
SOURCE_FETCH_TIMEOUT=30
MAX_SOURCE_SIZE_MB=20

# STORAGE
DATA_DIR=./data
MAX_CONVERSATION_HISTORY=30

# SECURITY
DEBUG=false
LOG_LEVEL=INFO

# STREAMING
ENABLE_STREAMING=true
