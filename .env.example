# APPLICATION
APP_NAME=GST Practice Copilot
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
STREAMLIT_PORT=8501

# LOCAL LLM CONFIGURATION (OpenAI-compatible: vLLM, Ollama /v1, llama.cpp, DeepInfra, etc.)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://retread-froth-stunning.ngrok-free.dev
LLM_API_KEY=
LLM_MODEL=gpt-oss-extended
LLM_TEMPERATURE=0
LLM_TIMEOUT=180
LLM_MAX_RETRIES=2

# OPTIONAL: HTTP Basic Authentication (e.g. for ngrok tunnels with basic-auth enabled)
LLM_BASIC_AUTH_USERNAME=colab
LLM_BASIC_AUTH_PASSWORD=yashsheth1234

# WEB SEARCH
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-3rXRGk-vvn7dJbaFhT7qypibQW8jaIAzGKH2pV33KnzgIqpNQ
MAX_SEARCH_RESULTS=10
MAX_RESEARCH_RETRIES=2

# SOURCE VALIDATION
ENFORCE_OFFICIAL_DOMAINS=true
SOURCE_FETCH_TIMEOUT=30
MAX_SOURCE_SIZE_MB=20

# STORAGE
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=20
MAX_CONVERSATION_HISTORY=30

# SECURITY
DEBUG=false
LOG_LEVEL=INFO

# STREAMING
ENABLE_STREAMING=true
